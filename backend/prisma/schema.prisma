generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        BigInt   @id @default(autoincrement())
  email     String   @unique @db.VarChar(255)
  password  String   @db.VarChar(255)
  username  String?  @map("username") @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  urls Url[]

  @@index([email])
  @@index([createdAt])
  @@map("users")
}

model Url {
  id          BigInt   @id @default(autoincrement())
  originalUrl String   @map("original_url") @db.Text
  slug        String   @unique @db.VarChar(7)
  userId      BigInt?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([createdAt])
  @@index([userId])
  @@map("urls")
}

model Analytics {
  id          BigInt   @id @default(autoincrement())
  urlId       BigInt   @map("url_id")
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  userAgent   String?  @map("user_agent") @db.Text
  visitedAt   DateTime @default(now()) @map("visited_at")
  originalUrl String   @map("original_url") @db.Text
  slug        String   @db.VarChar(7)

  @@map("analytics")
}
